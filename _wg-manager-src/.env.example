# Supabase-Projekt-URL (Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://dein-projekt.supabase.co
# Öffentlicher anon/publishable Key (Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_ANON_KEY=dein-anon-key

# Optional: Base-Path für GitHub Pages (Standard: /wg-manager/)
# VITE_BASE_PATH=/wg-manager/
# Optional: Zielordner für den Build (Standard: ../wg-manager)
# VITE_OUT_DIR=../wg-manager
